{
  "forbiddenPaths": [
    "wiki/**",
    "roadmap/**",
    "docs/internal/**",
    ".private/**",
    "**/*secret*",
    "**/*.key",
    "**/*.pfx",
    "api_keys.json",
    "private_*.md"
  ],
  "secretPatterns": [
    "(?i)(api[_-]?key|access[_-]?token|secret[_-]?key|password)\\s*[:=]\\s*['\"][A-Za-z0-9_\\-]{8,}['\"]",
    "ghp_[A-Za-z0-9]{36}",
    "gho_[A-Za-z0-9]{36}"
  ],
  "requireAllTestsPass": true,
  "allowedPublicBranches": [
    "master",
    "main",
    "development"
  ]
}
